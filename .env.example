# Скопіюйте у .env (cp .env.example .env) і змініть пароль. Файл .env не комітиться.

# --- стенд ---
WEB_REPLICAS=1            # кількість вебінстансів: 1 або 2 (або більше)
LB_PORT=8080              # порт балансувальника на хості
WEB_CPUS=0.5              # ліміт CPU контейнера web (варіант 5); ЛР2 крок 7: якщо точка N=1 обмежена генератором, зменшити вдвічі
WEB_MEMORY=512M           # ліміт памʼяті контейнера web (варіант 5)
PROM_PORT=9090            # порт Prometheus на хості (ЛР2)

# --- база даних ---
DB_NAME=studies
DB_USER=studies_app
DB_PASSWORD=change-me-before-first-run

# --- сервіс (усе тільки через змінні середовища, значень за замовчуванням у коді немає) ---
DB_POOL_MIN=2
DB_POOL_SIZE=15          # ЛР2, варіант 5: розмір пулу = найбільша кількість зʼєднань екземпляра
DB_CONNECT_TIMEOUT=3      # секунд
DB_COMMAND_TIMEOUT=5      # секунд
HTTP_WORKERS=1            # на 0.5 CPU більше одного процесу не має сенсу
DEFAULT_LIMIT=20          # limit за замовчуванням у GET /studies
MAX_LIMIT=100             # верхня межа limit
HISTOGRAM_BUCKETS_MS=1,2,4,8,16,32,64,128,256,512,1024   # ЛР2, варіант 5: набір Г3
LOG_LEVEL=info
ACCESS_LOG=false
